# Required backend runtime configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OPENAI_API_KEY=replace-me
ADZUNA_APP_ID=replace-me
ADZUNA_APP_KEY=replace-me
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-fernet-key

# The container binds $PORT (the Dockerfile defaults it to 10000, Railway injects
# its own). Set it only when overriding the local port.
# PORT=8000

# Browser/API origins. Local Vite development uses a proxy and needs neither.
# Production example: https://app.example.com
# Railway: set to the frontend service URL, e.g. https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=
# Optional regex for dynamic preview origins. Escape literal dots.
# Example: ^https://([a-z0-9-]+\.)?autogram\.example\.com$
CORS_ORIGIN_REGEX=

# Optional security/runtime settings
# API_KEY=replace-with-a-long-random-value
# JWT_EXPIRE_MINUTES=1440
# RATE_LIMIT_PER_MINUTE=60
# Redis (Phase 1) — a managed cloud Redis, same idea as DATABASE_URL/Neon.
# Unset = in-process rate limiter + event bus (SINGLE process only). REQUIRED
# for multiple API replicas or the Phase 2 worker.
#   - Managed/serverless (recommended): Upstash (upstash.com), Redis Cloud, or
#     Railway's Redis plugin. Use the TLS endpoint -> rediss:// scheme.
#     Example: rediss://default:TOKEN@equal-xyz-12345.upstash.io:6379
#   - Local via docker-compose: redis://redis:6379/0 (already set in compose)
#   - The provider must support RESP pub/sub (Upstash's RESP endpoint does; its
#     REST-only URL does not). Pub/sub volume here is tiny (one msg per apply
#     step), so any paid-per-command plan stays in the free tier.
# REDIS_URL=rediss://default:TOKEN@HOST:6379

# --- Phase 2 (apply-job worker / Celery queue) ---
# The worker process (`celery -A automation.worker.celery_app worker`) reuses
# REDIS_URL as its broker + result backend. Override only if you want them on a
# different instance/db.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# WORKER_CONCURRENCY=2        # concurrent Playwright applies per worker process
# COPILOT_APPROVAL_MAX_WAIT_SECONDS=1800   # cross-worker copilot approve (2f): how long a worker waits for a human before giving up
# COPILOT_APPROVAL_POLL_SECONDS=3          # how often it polls for the approve signal while waiting
# Set true ONLY when a trusted proxy (Railway, nginx) terminates the client
# connection — then the rate limiter reads X-Forwarded-For instead of the peer IP.
# TRUST_PROXY=false
# AUTOMATION_BROWSER_MODE=cdp
# AUTOMATION_HEADLESS=true
# AUTOMATION_CDP_URL=http://127.0.0.1:9222
# AUTOMATION_CDP_AUTOLAUNCH=true
# AUTOMATION_CDP_LAUNCH_TIMEOUT_S=30
# AUTOMATION_CHROME_PATH=
# AUTOMATION_CHROME_USER_DATA_DIR=storage/chrome_profile
# AUTOMATION_SESSION_DIR=storage/automation_sessions
# AUTOMATION_LOGS_DIR=logs
# AUTOMATION_HUMAN_WAIT_TIMEOUT_S=600
# AUTOMATION_VISION_FALLBACK=true
# AUTOGRAM_HUMAN_PACING=1
# RETENTION_PURGE_INTERVAL_HOURS=24

# Optional scheduled job ingestion
# JOB_SYNC_QUERIES=backend engineer;python developer
# JOB_SYNC_INTERVAL_HOURS=6
# JOB_SYNC_COUNTRY=gb

# Optional S3-compatible object storage (AWS S3, Cloudflare R2, MinIO)
# Phase 3 finishes wiring this into text extraction + the Playwright upload path.
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Password reset email ---
# Tried in this order: SMTP (if SMTP_USER/SMTP_PASSWORD set), then Resend (if
# RESEND_API_KEY set). Neither set = reset links are logged instead of emailed
# (local dev).
#
# SMTP (e.g. Gmail with an App Password — https://myaccount.google.com/apppasswords
# — requires 2FA enabled on the Google account; a regular account password will
# NOT work here). SMTP_PASSWORD is a secret — set it only here, never commit it.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=replace-with-a-16-char-app-password
#
# Resend (alternative to SMTP)
# RESEND_API_KEY=re_xxxxxxxx
#
# EMAIL_FROM=Autogram <no-reply@yourdomain.com>
# Frontend origin the reset link points at — must not end with a slash.
# APP_BASE_URL=https://app.yourdomain.com
# RESET_TOKEN_EXPIRE_MINUTES=30

# --- Phase 12 (separate admin console app) — not read yet ---
# ADMIN_BASE_URL=https://admin.yourdomain.com   # also add to CORS_ORIGINS
